# MaliMetal userspace stack example configuration (values intentionally blank).
# Used by .github/workflows/panvk-ios.yml (via workflow_dispatch target_os / config_overrides)
# or overridden by UniXNU-merlinx/configs/merlinx-iOS16.7.config.
#
# Supported parameters:
#
# Target OS preset: "ios16" | "ipados17" | "universal"
# - ios16:     min deployment 16.0, dynamic _MTLDevice ABI (size=0), artifact mali-gpu-ios16-HHMM-DDMMYY.addon
# - ipados17:  min deployment 17.0, strict iPadOS 17.7.11 _MTLDevice ABI (size=536), artifact mali-gpu-ipados17-HHMM-DDMMYY.addon
# - universal: min deployment 16.0, dynamic _MTLDevice ABI (size=0), runs on both iOS 16 and iPadOS 17
CONFIG_XNU_DW_MALIMETAL_TARGET_OS=""

# Minimum iOS/iPadOS deployment target passed to clang/meson (e.g. "16.0" or "17.0").
CONFIG_XNU_DW_MALIMETAL_IOS_MIN=""

# Expected sizeof(_MTLDevice) ABI guard in NativeBridgeMetalFrontend.mm:
# - 0   = accept any valid _MTLDevice base class (required for iOS 16.7.16 and universal builds)
# - 536 = enforce exact iPadOS 17.7.11 (21H461) _MTLDevice instance size
CONFIG_XNU_DW_MALIMETAL_MTLDEVICE_SIZE=

# Enable extra Metal/PanVK bridge diagnostic trace output (y | n; default: n).
CONFIG_XNU_DW_MALIMETAL_TRACE=
