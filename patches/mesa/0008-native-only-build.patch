# MaliMetal patch 0008: a native-only PanVK build without libdrm.
#
# Base: Mesa tag mesa-26.2.6, commit 8e87a503ebd91408c88596d1b9eeb5f4c0b2088d.
# Depends on 0001-0007.
#
# The target has no libdrm and no DRM render node. This option omits the
# panfrost/panthor DRM backends, the libdrm dependency, the DRM display WSI,
# the CSF/Valhall DRM architectures, and every DRM-only branch that would
# otherwise require a Linux ioctl or syncobj implementation. The native backend
# remains the only creation path. DRM code that still has a public declaration
# is compiled only where the option is off.
#
# This is the build configuration for the target PanVK artifact; it is not a
# hardware claim and it does not make the Linux `mesa-panvk` job target-native.
diff --git a/meson.build b/meson.build
index 37f2fd4..59c4cb5 100644
--- a/meson.build
+++ b/meson.build
@@ -1935,6 +1935,10 @@ else
   # dependencies (such as vk-runtime) linking to it
   dep_libdrm = null_dep
 endif
+if get_option('panfrost-native-only')
+  dep_libdrm = null_dep
+  pre_args += '-DPAN_KMOD_NATIVE_ONLY'
+endif
 if dep_libdrm.found()
   pre_args += '-DHAVE_LIBDRM'
   if with_dri_platform == 'drm' and with_dri
diff --git a/meson.options b/meson.options
index 93a60e3..1e12f56 100644
--- a/meson.options
+++ b/meson.options
@@ -915,3 +915,10 @@ option(
   value : false,
   description : 'Build panfrost Rust components.'
 )
+
+option(
+  'panfrost-native-only',
+  type : 'boolean',
+  value : false,
+  description : 'Build PanVK only through the native pan_kmod backend; omit DRM backends and libdrm.',
+)
diff --git a/src/panfrost/lib/kmod/meson.build b/src/panfrost/lib/kmod/meson.build
index 7798b19..da40512 100644
--- a/src/panfrost/lib/kmod/meson.build
+++ b/src/panfrost/lib/kmod/meson.build
@@ -3,10 +3,11 @@
 
 libpankmod_lib_files = files(
   'pan_kmod.c',
-  'panfrost_kmod.c',
-  'panthor_kmod.c',
   'pan_kmod_native_mali.c',
 )
+if not get_option('panfrost-native-only')
+  libpankmod_lib_files += files('panfrost_kmod.c', 'panthor_kmod.c')
+endif
 
 libpankmod_lib = static_library(
   'pankmod_lib',
@@ -14,11 +15,11 @@ libpankmod_lib = static_library(
   include_directories : [inc_include, inc_src, inc_panfrost],
   c_args : [no_override_init_args],
   gnu_symbol_visibility : 'hidden',
-  dependencies: [dep_libdrm, idep_mesautil, idep_pan_packers, libpanfrost_model_dep],
+  dependencies: [idep_mesautil, idep_pan_packers, libpanfrost_model_dep],
   build_by_default : false,
 )
 
 libpankmod_dep = declare_dependency(
   include_directories: [inc_include, inc_src],
-  dependencies: [dep_libdrm],
+  dependencies: [],
 )
