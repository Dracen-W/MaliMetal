@@ -740,7 +770,12 @@ struct pan_kmod_bo *pan_kmod_bo_import(struct pan_kmod_dev *dev, int fd);
 static inline int
 pan_kmod_bo_export(struct pan_kmod_bo *bo)
 {
+#ifdef PAN_KMOD_NATIVE_ONLY
+   (void)bo;
+   return -1;
+#else
    return bo->dev->ops->bo_export(bo);
+#endif
 }
 
