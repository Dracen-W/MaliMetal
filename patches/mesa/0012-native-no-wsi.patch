# MaliMetal patch 0012: do not link the WSI archive into native PanVK.
#
# Base: Mesa tag mesa-26.2.6, commit 8e87a503ebd91408c88596d1b9eeb5f4c0b2088d.
# Depends on 0001-0011.
#
# With the DRM WSI entrypoints and swapchain image paths compiled out, the
# native target has no references to libvulkan_wsi. Linking it only pulls
# wsi_common_entrypoints.c and its DRM/display dispatch table, which cannot
# link on the target. Keep the headers, drop the archive, and initialise the
# now-unused native memory handle.
diff --git a/src/panfrost/vulkan/meson.build b/src/panfrost/vulkan/meson.build
--- a/src/panfrost/vulkan/meson.build
+++ b/src/panfrost/vulkan/meson.build
@@ -214,7 +214,7 @@ libvulkan_panfrost = shared_library(
   link_whole : [panvk_per_arch_libs],
   link_with : [
     libpanfrost_shared,
-    (get_option('panfrost-native-only') ? [libvulkan_wsi, libvulkan_lite_runtime, libvulkan_runtime, libvulkan_instance] : []),
+    (get_option('panfrost-native-only') ? [libvulkan_lite_runtime, libvulkan_runtime, libvulkan_instance] : []),
     libpanfrost_decode,
     libpanfrost_lib,
     libpanfrost_compiler,
diff --git a/src/panfrost/vulkan/panvk_image.c b/src/panfrost/vulkan/panvk_image.c
--- a/src/panfrost/vulkan/panvk_image.c
+++ b/src/panfrost/vulkan/panvk_image.c
@@ -1334,6 +1334,6 @@ panvk_image_bind(struct panvk_device *dev,
 
    if (!mem) {
-      VkDeviceMemory mem_handle;
+      VkDeviceMemory mem_handle = VK_NULL_HANDLE;
 #ifdef VK_USE_PLATFORM_ANDROID_KHR
       VkResult result =
          panvk_android_get_wsi_memory(dev, bind_info, &mem_handle);
