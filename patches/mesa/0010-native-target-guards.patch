# MaliMetal patch 0010: complete the native target build guards.
#
# Base: Mesa tag mesa-26.2.6, commit 8e87a503ebd91408c88596d1b9eeb5f4c0b2088d.
# Depends on 0001-0009.
#
# Completes the native-only build path for the Bifrost v7 target: restrict the
# per-arch dispatch to v7, retain the image DRM modifier storage without libdrm,
# guard the DRM physical-device/WSI branches, and keep the WSI headers while
# omitting the DRM WSI implementation. No hardware claim is made.
diff --git a/src/panfrost/vulkan/meson.build b/src/panfrost/vulkan/meson.build
index bfc7457..c912684 100644
--- a/src/panfrost/vulkan/meson.build
+++ b/src/panfrost/vulkan/meson.build
@@ -142,7 +142,13 @@ common_per_arch_files = [
   sha1_h,
 ]
 
-foreach arch : [6, 7, 10, 12, 13, 14]
+if get_option('panfrost-native-only')
+  panvk_archs = [7]
+else
+  panvk_archs = [6, 7, 10, 12, 13, 14]
+endif
+
+foreach arch : panvk_archs
   per_arch_files = common_per_arch_files
   inc_panvk_per_arch = []
 
