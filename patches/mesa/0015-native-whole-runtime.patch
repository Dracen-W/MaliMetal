# MaliMetal patch 0015: whole-load the Vulkan runtime archives in native PanVK.
#
# Base: Mesa tag mesa-26.2.6, commit 8e87a503ebd91408c88596d1b9eeb5f4c0b2088d.
# Depends on 0001-0014.
#
# The generated vk_common entrypoint table lives in libvulkan_lite_runtime, but
# its implementations are only pulled when the runtime archives are whole-loaded
# in the native link. Without the WSI archive (0013/0014) the ordinary archive
# order no longer supplies them. Whole-load the three runtime archives and drop
# the now-redundant link_with entry.
diff --git a/src/panfrost/vulkan/meson.build b/src/panfrost/vulkan/meson.build
--- a/src/panfrost/vulkan/meson.build
+++ b/src/panfrost/vulkan/meson.build
@@ -214,8 +214,8 @@ libvulkan_panfrost = shared_library(
   ],
-  link_whole : [panvk_per_arch_libs],
+  link_whole : [panvk_per_arch_libs] + (get_option('panfrost-native-only') ?
+    [libvulkan_lite_runtime, libvulkan_runtime, libvulkan_instance] : []),
   link_with : [
     libpanfrost_shared,
-    (get_option('panfrost-native-only') ? [libvulkan_lite_runtime, libvulkan_runtime, libvulkan_instance] : []),
     libpanfrost_decode,
     libpanfrost_lib,
     libpanfrost_compiler,
