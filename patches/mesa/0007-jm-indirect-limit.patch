# MaliMetal patch 0007: bound the PanVK JM indirect buffer to the NativeMali BO limit.
#
# Base: Mesa tag mesa-26.2.6, commit 8e87a503ebd91408c88596d1b9eeb5f4c0b2088d.
# Depends on 0005 (the native physical device).
#
# PanVK allocates its JM indirect/attribute buffer for two million vertices at
# 18 attribute words each: 144 MB. NativeMali v2 limits one BO to 2^27 bytes
# (128 MB), so a native device would fail before the first queue existed. This
# lowers the bring-up constant to 1.5 million vertices (108 MB); it is a
# functional limit, not a hidden fallback. The alternative is a larger kernel
# BO limit or a different indirect allocation strategy.
#
# Compiled by the mesa-panvk CI job. It has not been run on hardware.
diff --git a/src/panfrost/vulkan/panvk_device.h b/src/panfrost/vulkan/panvk_device.h
--- a/src/panfrost/vulkan/panvk_device.h
+++ b/src/panfrost/vulkan/panvk_device.h
@@ -33,11 +33,11 @@
  * As a result, for indirect and indexed draw we allocate a large buffer with
  * alloc on fault set.
  *
- * The size of that buffer is calculated assuming a max of 2 millions vertices
+ * The size of that buffer is calculated assuming a max of 1.5 million vertices
  * and 18 attributes per vertex (16 user attributes, 2 specials)
  */
 
-#define PANVK_JM_MAX_VERTICES_INDIRECT                (2000000)
+#define PANVK_JM_MAX_VERTICES_INDIRECT                (1500000)
 #define PANVK_JM_MAX_PER_VTX_ATTRIBUTES_INDIRECT_SIZE (18 * 4)
 
 struct panvk_precomp_cache;
