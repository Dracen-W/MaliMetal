# MaliMetal patch 0023: zero-copy VK_EXT_external_memory_host + EL1 BO sync.
#
# Base: Mesa tag mesa-26.3.1, commit fec8830e9c94b1d67f3d8469467d5529fb2978cd.
# Depends on 0002 (pan_kmod_native_mali_bo_import_host + flush_bo_map_syncs)
# and Mali-G52 NativeMaliMethodBoImportHost (12) / NativeMaliMethodBoSync (13).
#
# Advertises VK_EXT_external_memory_host under PAN_KMOD_NATIVE_ONLY so
# metal2vulkan can import IOSurface and MTLBuffer no-copy host allocations
# zero-copy into Mali-G52 GPU VA space, and flushes pending kernel-side BO
# cache syncs before every native queue submission.
diff --git a/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c b/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c
index d19ce01..fdd07e0 100644
--- a/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c
+++ b/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c
@@ -293,6 +293,10 @@ panvk_per_arch(gpu_queue_submit_native)(struct vk_queue *vk_queue,
       container_of(vk_queue, struct panvk_gpu_queue, vk);
    struct panvk_device *dev = to_panvk_device(queue->vk.base.device);
 
+   /* Flush any pending WB-mapped / imported host BO cache syncs through EL1
+    * before Mali-G52 reads them. */
+   pan_kmod_flush_bo_map_syncs(dev->kmod.dev);
+
    /* NativeMali has one wait fence per submit and one out fence per job.
     * Drain any extra non-zero wait fences before passing the last one to the
     * kernel submit. */
diff --git a/src/panfrost/vulkan/panvk_device_memory.c b/src/panfrost/vulkan/panvk_device_memory.c
index 3e302ef..c424399 100644
--- a/src/panfrost/vulkan/panvk_device_memory.c
+++ b/src/panfrost/vulkan/panvk_device_memory.c
@@ -11,6 +11,9 @@
 #include "panvk_device.h"
 #include "panvk_device_memory.h"
 #include "panvk_entrypoints.h"
+#ifdef PAN_KMOD_NATIVE_ONLY
+#include "kmod/pan_kmod_native_mali.h"
+#endif
 
 #include "pan_props.h"
 
@@ -91,6 +94,13 @@ panvk_AllocateMemory(VkDevice _device,
 
    const VkImportMemoryFdInfoKHR *fd_info =
       vk_find_struct_const(pAllocateInfo->pNext, IMPORT_MEMORY_FD_INFO_KHR);
+#ifdef PAN_KMOD_NATIVE_ONLY
+   const VkImportMemoryHostPointerInfoEXT *host_ptr_info =
+      vk_find_struct_const(pAllocateInfo->pNext,
+                           IMPORT_MEMORY_HOST_POINTER_INFO_EXT);
+   if (host_ptr_info && !host_ptr_info->handleType)
+      host_ptr_info = NULL;
+#endif
 
    if (fd_info && !fd_info->handleType)
       fd_info = NULL;
@@ -105,6 +115,29 @@ panvk_AllocateMemory(VkDevice _device,
          result = panvk_error(device, VK_ERROR_INVALID_EXTERNAL_HANDLE);
          goto err_destroy_mem;
       }
+#ifdef PAN_KMOD_NATIVE_ONLY
+   } else if (host_ptr_info) {
+      if ((host_ptr_info->handleType !=
+              VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT &&
+           host_ptr_info->handleType !=
+              VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_MAPPED_FOREIGN_MEMORY_BIT_EXT) ||
+          host_ptr_info->pHostPointer == NULL ||
+          (((uintptr_t)host_ptr_info->pHostPointer) & 4095u) != 0) {
+         result = panvk_error(device, VK_ERROR_INVALID_EXTERNAL_HANDLE);
+         goto err_destroy_mem;
+      }
+
+      uint32_t bo_flags = PAN_KMOD_BO_FLAG_WB_MMAP;
+      bo_flags = panvk_device_adjust_bo_flags(device, bo_flags);
+      mem->bo = pan_kmod_native_mali_bo_import_host(
+         device->kmod.dev, device->kmod.vm, host_ptr_info->pHostPointer,
+         pAllocateInfo->allocationSize, bo_flags);
+      if (!mem->bo) {
+         result = panvk_error(device, VK_ERROR_INVALID_EXTERNAL_HANDLE);
+         goto err_destroy_mem;
+      }
+      mem->is_host_imported = true;
+#endif
    } else {
       uint32_t bo_flags = 0;
 
@@ -261,7 +294,7 @@ panvk_FreeMemory(VkDevice _device, VkDeviceMemory _mem,
          os_munmap(mem->debug.host_mapping, pan_kmod_bo_size(mem->bo));
    }
 
-   if (mem->addr.host) {
+   if (mem->addr.host && !mem->is_host_imported) {
       ASSERTED int ret = os_munmap(mem->addr.host, pan_kmod_bo_size(mem->bo));
       assert(!ret);
    }
@@ -364,7 +397,9 @@ panvk_UnmapMemory2KHR(VkDevice _device,
    VK_FROM_HANDLE(panvk_device, device, _device);
    VK_FROM_HANDLE(panvk_device_memory, mem, pMemoryUnmapInfo->memory);
 
-   if (pMemoryUnmapInfo->flags & VK_MEMORY_UNMAP_RESERVE_BIT_EXT) {
+   if (mem->is_host_imported) {
+      /* Caller / IOSurface owns the host VA; never munmap it. */
+   } else if (pMemoryUnmapInfo->flags & VK_MEMORY_UNMAP_RESERVE_BIT_EXT) {
       void *reserved =
          os_mmap(mem->addr.host, pan_kmod_bo_size(mem->bo), PROT_NONE,
                  MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED, -1, 0);
@@ -509,3 +544,32 @@ panvk_GetDeviceMemoryOpaqueCaptureAddress(
 
    return memory->addr.dev;
 }
+
+#ifdef PAN_KMOD_NATIVE_ONLY
+VKAPI_ATTR VkResult VKAPI_CALL
+panvk_GetMemoryHostPointerPropertiesEXT(
+   VkDevice _device, VkExternalMemoryHandleTypeFlagBits handleType,
+   const void *pHostPointer,
+   VkMemoryHostPointerPropertiesEXT *pMemoryHostPointerProperties)
+{
+   VK_FROM_HANDLE(panvk_device, device, _device);
+   const struct panvk_physical_device *phys_dev =
+      to_panvk_physical_device(device->vk.physical);
+
+   if ((handleType != VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT &&
+        handleType !=
+           VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_MAPPED_FOREIGN_MEMORY_BIT_EXT) ||
+       pHostPointer == NULL || (((uintptr_t)pHostPointer) & 4095u) != 0)
+      return panvk_error(device, VK_ERROR_INVALID_EXTERNAL_HANDLE);
+
+   uint32_t memory_type_bits = 0;
+   for (uint32_t i = 0; i < phys_dev->memory.type_count; i++) {
+      if (phys_dev->memory.types[i].propertyFlags &
+          VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT)
+         memory_type_bits |= BITFIELD_BIT(i);
+   }
+
+   pMemoryHostPointerProperties->memoryTypeBits = memory_type_bits;
+   return VK_SUCCESS;
+}
+#endif
diff --git a/src/panfrost/vulkan/panvk_device_memory.h b/src/panfrost/vulkan/panvk_device_memory.h
index 6fc545b..e199cd4 100644
--- a/src/panfrost/vulkan/panvk_device_memory.h
+++ b/src/panfrost/vulkan/panvk_device_memory.h
@@ -15,6 +15,7 @@ struct panvk_priv_bo;
 struct panvk_device_memory {
    struct vk_device_memory vk;
    struct pan_kmod_bo *bo;
+   bool is_host_imported;
    struct {
       uint64_t dev;
       void *host;
diff --git a/src/panfrost/vulkan/panvk_physical_device.c b/src/panfrost/vulkan/panvk_physical_device.c
index dc5aeca..84e342a 100644
--- a/src/panfrost/vulkan/panvk_physical_device.c
+++ b/src/panfrost/vulkan/panvk_physical_device.c
@@ -1621,6 +1621,24 @@ panvk_get_external_image_format_properties(
    VkExternalMemoryHandleTypeFlagBits handleType,
    VkExternalMemoryProperties *external_properties)
 {
+#ifdef PAN_KMOD_NATIVE_ONLY
+   if (handleType == VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT ||
+       handleType ==
+          VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_MAPPED_FOREIGN_MEMORY_BIT_EXT) {
+      if (pImageFormatInfo->type != VK_IMAGE_TYPE_2D ||
+          pImageFormatInfo->tiling != VK_IMAGE_TILING_LINEAR) {
+         return panvk_errorf(physical_device, VK_ERROR_FORMAT_NOT_SUPPORTED,
+                             "Host memory import requires 2D linear image");
+      }
+      *external_properties = (VkExternalMemoryProperties){
+         .externalMemoryFeatures = VK_EXTERNAL_MEMORY_FEATURE_IMPORTABLE_BIT,
+         .exportFromImportedHandleTypes = 0,
+         .compatibleHandleTypes = handleType,
+      };
+      return VK_SUCCESS;
+   }
+#endif
+
    const VkExternalMemoryHandleTypeFlags supported_handle_types =
       VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_FD_BIT |
       VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT;
@@ -1968,6 +1986,21 @@ panvk_GetPhysicalDeviceExternalBufferProperties(
       return;
    }
 
+#ifdef PAN_KMOD_NATIVE_ONLY
+   if (pExternalBufferInfo->handleType ==
+          VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT ||
+       pExternalBufferInfo->handleType ==
+          VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_MAPPED_FOREIGN_MEMORY_BIT_EXT) {
+      pExternalBufferProperties->externalMemoryProperties =
+         (VkExternalMemoryProperties){
+            .externalMemoryFeatures = VK_EXTERNAL_MEMORY_FEATURE_IMPORTABLE_BIT,
+            .exportFromImportedHandleTypes = 0,
+            .compatibleHandleTypes = pExternalBufferInfo->handleType,
+         };
+      return;
+   }
+#endif
+
    const VkExternalMemoryHandleTypeFlags supported_handle_types =
       VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_FD_BIT |
       VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT;
diff --git a/src/panfrost/vulkan/panvk_vX_physical_device.c b/src/panfrost/vulkan/panvk_vX_physical_device.c
index eb32e85..241b6d6 100644
--- a/src/panfrost/vulkan/panvk_vX_physical_device.c
+++ b/src/panfrost/vulkan/panvk_vX_physical_device.c
@@ -170,6 +170,9 @@ panvk_per_arch(get_physical_device_extensions)(
       .EXT_extended_dynamic_state3 = true,
