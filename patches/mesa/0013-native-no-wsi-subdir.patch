# MaliMetal patch 0013: omit the WSI subdirectory from native PanVK.
#
# Base: Mesa tag mesa-26.2.6, commit 8e87a503ebd91408c88596d1b9eeb5f4c0b2088d.
# Depends on 0001-0012.
#
# 0012 stops linking the WSI archive, but the archive is still built and its
# generated dispatch table still enters the link graph on Darwin. The native
# target has no swapchain/WSI implementation, so do not configure or build the
# WSI subdirectory at all; keep its headers for type declarations and provide
# empty dependency objects for the remaining Mesa targets.
diff --git a/src/vulkan/meson.build b/src/vulkan/meson.build
--- a/src/vulkan/meson.build
+++ b/src/vulkan/meson.build
@@ -86,7 +86,15 @@ idep_vulkan_wsi_defines = declare_dependency(
 
 subdir('util')
 subdir('runtime')
-subdir('wsi')
+if not get_option('panfrost-native-only')
+  subdir('wsi')
+else
+  idep_vulkan_wsi_defines = declare_dependency()
+  idep_vulkan_wsi_headers = declare_dependency(
+    include_directories : include_directories('wsi'),
+  )
+  vulkan_wsi_deps = []
+endif
 if with_vulkan_overlay_layer
   subdir('overlay-layer')
 endif
