# MaliMetal patch 0005: enumerate and create a PanVK physical device without
# /dev/dri.
#
# Base: Mesa tag mesa-26.2.6, commit 8e87a503ebd91408c88596d1b9eeb5f4c0b2088d.
# Depends on 0001-0004 and 0006 (the native vk_sync type).
#
# With MALIMETAL_NATIVE set, the instance enumerates through the
# NativeMaliGpuService instead of drmGetDevices2(), the physical device reports
# NativeMali properties, and the logical device shares the physical device's
# single client/VM. A missing service is an incompatible driver, not a fake DRM
# node. Without the variable the DRM path is unchanged.
#
# Compiled by the mesa-panvk CI job. It has not been run on hardware; MM4 still
# needs the service and a working kernel job.
diff --git a/src/panfrost/vulkan/panvk_device.h b/src/panfrost/vulkan/panvk_device.h
index c81d537..2e1cb04 100644
--- a/src/panfrost/vulkan/panvk_device.h
+++ b/src/panfrost/vulkan/panvk_device.h
@@ -130,6 +130,7 @@ struct panvk_device {
    };
 
    int drm_fd;
+   bool native_shared_kmod;
 };
 
 VK_DEFINE_HANDLE_CASTS(panvk_device, vk.base, VkDevice, VK_OBJECT_TYPE_DEVICE)
diff --git a/src/panfrost/vulkan/panvk_instance.c b/src/panfrost/vulkan/panvk_instance.c
index 102dc93..dbc1b39 100644
--- a/src/panfrost/vulkan/panvk_instance.c
+++ b/src/panfrost/vulkan/panvk_instance.c
@@ -158,6 +158,47 @@ panvk_physical_device_try_create(struct vk_instance *vk_instance,
    return VK_SUCCESS;
 }
 
+static VkResult
+panvk_physical_device_try_create_native(struct vk_instance *vk_instance,
+                                        struct vk_physical_device **out)
+{
+   struct panvk_instance *instance =
+      container_of(vk_instance, struct panvk_instance, vk);
+
+   struct panvk_physical_device *device =
+      vk_zalloc(&instance->vk.alloc, sizeof(*device), 8,
+                VK_SYSTEM_ALLOCATION_SCOPE_INSTANCE);
+   if (!device)
+      return panvk_error(instance, VK_ERROR_OUT_OF_HOST_MEMORY);
+
+   VkResult result = panvk_physical_device_init(device, instance, NULL);
+   if (result != VK_SUCCESS) {
+      vk_free(&instance->vk.alloc, device);
+      return result;
+   }
+
+   *out = &device->vk;
+   return VK_SUCCESS;
+}
+
+static VkResult
+panvk_enumerate_native(struct vk_instance *vk_instance)
+{
+   if (!panvk_native_mali_enabled())
+      return VK_ERROR_INCOMPATIBLE_DRIVER;
+
+   struct vk_physical_device *device;
+   VkResult result = panvk_physical_device_try_create_native(vk_instance,
+                                                              &device);
+   if (result != VK_SUCCESS) {
+      mesa_loge("native_mali: physical device creation failed: %d", result);
+      return result;
+   }
+
+   list_addtail(&device->link, &vk_instance->physical_devices.list);
+   return VK_SUCCESS;
+}
+
 static void
 panvk_destroy_physical_device(struct vk_physical_device *device)
 {
@@ -257,6 +296,7 @@ panvk_CreateInstance(const VkInstanceCreateInfo *pCreateInfo,
       .priv = &instance->vk.alloc,
    };
 
+   instance->vk.physical_devices.enumerate = panvk_enumerate_native;
    instance->vk.physical_devices.try_create_for_drm =
       panvk_physical_device_try_create;
    instance->vk.physical_devices.destroy = panvk_destroy_physical_device;
diff --git a/src/panfrost/vulkan/panvk_physical_device.c b/src/panfrost/vulkan/panvk_physical_device.c
index e7e64e2..34456f1 100644
--- a/src/panfrost/vulkan/panvk_physical_device.c
+++ b/src/panfrost/vulkan/panvk_physical_device.c
@@ -34,6 +34,9 @@
 #include "panvk_physical_device.h"
 #include "panvk_wsi.h"
 
+#include "native_mali_kmod.h"
+#include "kmod/pan_kmod_native_mali.h"
+
 #include "pan_afbc.h"
 #include "pan_props.h"
 
@@ -70,10 +73,50 @@ PER_ARCH_FUNCS(12);
 PER_ARCH_FUNCS(13);
 PER_ARCH_FUNCS(14);
 
+bool
+panvk_native_mali_enabled(void)
+{
+   return os_get_option("MALIMETAL_NATIVE") != NULL;
+}
+
 static VkResult
 create_kmod_dev(struct panvk_physical_device *device,
                 const struct panvk_instance *instance, drmDevicePtr drm_device)
 {
+   if (panvk_native_mali_enabled()) {
+      if (device->native_kmod != NULL)
+         return VK_SUCCESS;
+
+      if (native_mali_kmod_create_default == NULL)
+         return panvk_errorf(instance, VK_ERROR_INCOMPATIBLE_DRIVER,
+                             "MaliMetal facade is not linked");
+
+      NativeMaliResult error = NATIVE_MALI_RESULT_UNKNOWN;
+      NativeMaliKmod *kmod = native_mali_kmod_create_default(&error);
+      if (kmod == NULL) {
+         return panvk_errorf(instance, VK_ERROR_INCOMPATIBLE_DRIVER,
+                             "NativeMali service unavailable (%s)",
+                             native_mali_kmod_error_name(error));
+      }
+
+      device->kmod.dev = pan_kmod_dev_create_native_mali(
+         kmod, &instance->kmod.allocator);
+      if (device->kmod.dev == NULL) {
+         native_mali_kmod_destroy(kmod);
+         return panvk_errorf(instance, VK_ERROR_INCOMPATIBLE_DRIVER,
+                             "NativeMali did not describe a usable device");
+      }
+
+      device->native_kmod = kmod;
+      device->native = true;
+      if (PANVK_DEBUG(STARTUP))
+         mesa_logi("Found NativeMali device through the service.");
+      return VK_SUCCESS;
+   }
+
+   if (drm_device == NULL || drm_device->nodes[DRM_NODE_RENDER] == NULL)
+      return VK_ERROR_INCOMPATIBLE_DRIVER;
+
    const char *path = drm_device->nodes[DRM_NODE_RENDER];
    drmVersionPtr version;
    int fd;
@@ -126,6 +169,15 @@ get_drm_device_ids(struct panvk_physical_device *device,
 {
    struct stat st;
 
+   if (device->native) {
+      device->drm.render_rdev = 0;
+      device->drm.primary_rdev = 0;
+      return VK_SUCCESS;
+   }
+
+   if (drm_device == NULL || drm_device->nodes[DRM_NODE_RENDER] == NULL)
+      return VK_ERROR_INCOMPATIBLE_DRIVER;
+
    if (stat(drm_device->nodes[DRM_NODE_RENDER], &st)) {
       return vk_errorf(instance, VK_ERROR_INITIALIZATION_FAILED,
                        "failed to query render node stat");
@@ -383,6 +435,13 @@ get_device_sync_types(struct panvk_physical_device *device,
    const unsigned arch = pan_arch(device->kmod.dev->props.gpu_id);
    uint32_t sync_type_count = 0;
 
+   if (device->native) {
+      device->native_sync_type = *panvk_native_sync_get_type();
+      device->sync_types[sync_type_count++] = &device->native_sync_type;
+      device->sync_types[sync_type_count] = NULL;
+      return VK_SUCCESS;
+   }
+
    device->drm_syncobj_type = vk_drm_syncobj_get_type(device->kmod.dev->fd);
    if (!device->drm_syncobj_type.features) {
       return vk_errorf(instance, VK_ERROR_INITIALIZATION_FAILED,
@@ -430,6 +489,11 @@ panvk_physical_device_finish(struct panvk_physical_device *device)
 
    pan_kmod_dev_destroy(device->kmod.dev);
 
+   if (device->native_kmod != NULL) {
+      native_mali_kmod_destroy(device->native_kmod);
+      device->native_kmod = NULL;
+   }
+
    release_memory_budget(device->memory.budget);
 
    vk_physical_device_finish(&device->vk);
@@ -565,6 +629,11 @@ fail:
 
    pan_kmod_dev_destroy(device->kmod.dev);
 
+   if (device->native_kmod != NULL) {
+      native_mali_kmod_destroy(device->native_kmod);
+      device->native_kmod = NULL;
+   }
+
    return result;
 }
 
