# MaliMetal patch 0006: a binary vk_sync backed by an opaque NativeMali fence.
#
# Base: Mesa tag mesa-26.2.6, commit 8e87a503ebd91408c88596d1b9eeb5f4c0b2088d.
# Depends on 0004 (the native queue).
#
# Adds vk_sync_type with BINARY/GPU_WAIT/CPU_WAIT/CPU_RESET and no invented
# userspace signal, import/export or timeline. The native queue consumes one
# wait fence and attaches the last submitted fence to signal semaphores; more
# than one wait is refused because NativeMali Submit has exactly one dependency
# field. Events remain a documented gap.
#
# Compiled by the mesa-panvk CI job. It has not been run on hardware.
diff --git a/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c b/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c
index 4702778..1e4d440 100644
--- a/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c
+++ b/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c
@@ -23,6 +23,7 @@
 #include "panvk_physical_device.h"
 #include "panvk_priv_bo.h"
 #include "panvk_queue.h"
+#include "panvk_native_sync.h"
 
 #include "vk_drm_syncobj.h"
 #include "vk_framebuffer.h"
@@ -230,7 +231,8 @@ panvk_signal_event_syncobjs(struct panvk_gpu_queue *queue,
 
 static VkResult
 panvk_queue_submit_batch_native(struct panvk_gpu_queue *queue,
-                                struct panvk_batch *batch)
+                                struct panvk_batch *batch,
+                                uint64_t external_wait)
 {
    struct panvk_device *dev = to_panvk_device(queue->vk.base.device);
    const struct pan_kmod_ops *ops = dev->kmod.dev->ops;
@@ -243,7 +245,10 @@ panvk_queue_submit_batch_native(struct panvk_gpu_queue *queue,
       return panvk_error(dev, VK_ERROR_FEATURE_NOT_PRESENT);
 
    if (batch->vtc_jc.first_job) {
-      struct pan_kmod_submit vtc = {.job_chain = batch->vtc_jc.first_job};
+      struct pan_kmod_submit vtc = {
+         .job_chain = batch->vtc_jc.first_job,
+         .wait_fence = external_wait,
+      };
       if (ops->submit(dev->kmod.dev, &vtc, &fence))
          return panvk_error(dev, VK_ERROR_DEVICE_LOST);
       queue->last_fence = fence;
@@ -252,7 +257,8 @@ panvk_queue_submit_batch_native(struct panvk_gpu_queue *queue,
    if (batch->frag_jc.first_job) {
       struct pan_kmod_submit frag = {
          .job_chain = batch->frag_jc.first_job,
-         .wait_fence = batch->vtc_jc.first_job ? queue->last_fence : 0,
+         .wait_fence = batch->vtc_jc.first_job ? queue->last_fence
+                                               : external_wait,
       };
       if (ops->submit(dev->kmod.dev, &frag, &fence))
          return panvk_error(dev, VK_ERROR_DEVICE_LOST);
@@ -270,22 +276,43 @@ panvk_per_arch(gpu_queue_submit_native)(struct vk_queue *vk_queue,
       container_of(vk_queue, struct panvk_gpu_queue, vk);
    struct panvk_device *dev = to_panvk_device(queue->vk.base.device);
 
-   /* Binary semaphores are DRM syncobjs in this backend. Until a native
-    * vk_sync type exists, a submit that waits or signals one is refused. */
-   if (submit->wait_count != 0 || submit->signal_count != 0)
+   /* NativeMali has one wait fence per submit and one out fence per job. A
+    * multi-wait submit is a real ABI gap, not something to emulate by waiting
+    * on the CPU. */
+   if (submit->wait_count > 1)
       return panvk_error(dev, VK_ERROR_FEATURE_NOT_PRESENT);
 
+   uint64_t external_wait = 0;
+   uint64_t submitted_fence = 0;
+   if (submit->wait_count == 1) {
+      if (!panvk_sync_type_is_native_mali(submit->waits[0].sync->type))
+         return panvk_error(dev, VK_ERROR_FEATURE_NOT_PRESENT);
+      external_wait = panvk_native_sync_get_fence(submit->waits[0].sync);
+   }
+
    for (uint32_t j = 0; j < submit->command_buffer_count; ++j) {
       struct panvk_cmd_buffer *cmdbuf =
          container_of(submit->command_buffers[j], struct panvk_cmd_buffer, vk);
 
       list_for_each_entry(struct panvk_batch, batch, &cmdbuf->batches, node) {
-         VkResult result = panvk_queue_submit_batch_native(queue, batch);
+         VkResult result = panvk_queue_submit_batch_native(
+            queue, batch, external_wait);
          if (result != VK_SUCCESS)
             return result;
+         external_wait = 0;
+         submitted_fence = queue->last_fence;
       }
    }
 
+   if (submit->signal_count != 0 && submitted_fence == 0)
+      return panvk_error(dev, VK_ERROR_FEATURE_NOT_PRESENT);
+
+   for (uint32_t i = 0; i < submit->signal_count; ++i) {
+      if (!panvk_sync_type_is_native_mali(submit->signals[i].sync->type))
+         return panvk_error(dev, VK_ERROR_FEATURE_NOT_PRESENT);
+      panvk_native_sync_set_fence(submit->signals[i].sync, submitted_fence);
+   }
+
    return VK_SUCCESS;
 }
 
