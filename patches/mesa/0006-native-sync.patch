diff --git a/src/panfrost/vulkan/panvk_native_sync.c b/src/panfrost/vulkan/panvk_native_sync.c
new file mode 100644
index 0000000..21bb9da
--- /dev/null
+++ b/src/panfrost/vulkan/panvk_native_sync.c
@@ -0,0 +1,145 @@
+/*
+ * Copyright © 2026 MaliMetal contributors
+ * SPDX-License-Identifier: MIT
+ *
+ * NativeMali fence-backed binary vk_sync. The fence is an opaque value from
+ * NativeMali Submit; waiting is the only operation the ABI can honestly offer.
+ */
+#include "panvk_native_sync.h"
+
+#include <limits.h>
+
+#include "util/os_time.h"
+#include "vk_log.h"
+#include "panvk_device.h"
+
+struct panvk_native_sync {
+   struct vk_sync sync;
+   uint64_t fence;
+   bool signaled;
+};
+
+static struct panvk_native_sync *
+to_native_sync(struct vk_sync *sync)
+{
+   assert(sync->type == panvk_native_sync_get_type());
+   return container_of(sync, struct panvk_native_sync, sync);
+}
+
+static VkResult
+panvk_native_sync_init(struct vk_device *device, struct vk_sync *sync,
+                       uint64_t initial_value)
+{
+   struct panvk_native_sync *native = to_native_sync(sync);
+   native->fence = 0;
+   native->signaled = initial_value != 0;
+   return VK_SUCCESS;
+}
+
+static void
+panvk_native_sync_finish(struct vk_device *device, struct vk_sync *sync)
+{
+   (void)device;
+   (void)sync;
+}
+
+static VkResult
+panvk_native_sync_reset(struct vk_device *device, struct vk_sync *sync)
+{
+   (void)device;
+   struct panvk_native_sync *native = to_native_sync(sync);
+   native->fence = 0;
+   native->signaled = false;
+   return VK_SUCCESS;
+}
+
+static VkResult
+panvk_native_sync_wait(struct vk_device *device, struct vk_sync *sync,
+                       uint64_t wait_value, enum vk_sync_wait_flags wait_flags,
+                       uint64_t abs_timeout_ns)
+{
+   (void)wait_value;
+   struct panvk_native_sync *native = to_native_sync(sync);
+
+   if (wait_flags & VK_SYNC_WAIT_PENDING)
+      return VK_ERROR_FEATURE_NOT_PRESENT;
+
+   if (native->fence == 0)
+      return native->signaled ? VK_SUCCESS : VK_TIMEOUT;
+
+   struct panvk_device *dev = container_of(device, struct panvk_device, vk);
+   if (dev->kmod.dev->ops->wait_fence == NULL)
+      return VK_ERROR_FEATURE_NOT_PRESENT;
+
+   uint64_t timeout_ns = UINT64_MAX;
+   if (abs_timeout_ns != OS_TIMEOUT_INFINITE) {
+      const uint64_t now = os_time_get_nano();
+      timeout_ns = abs_timeout_ns > now ? abs_timeout_ns - now : 0;
+   }
+
+   const int ret = dev->kmod.dev->ops->wait_fence(dev->kmod.dev, native->fence,
+                                                   timeout_ns);
+   if (ret)
+      return VK_TIMEOUT;
+
+   /* A successful wait consumes a binary semaphore. */
+   native->fence = 0;
+   native->signaled = false;
+   return VK_SUCCESS;
+}
+
+static VkResult
+panvk_native_sync_wait_many(struct vk_device *device, uint32_t wait_count,
+                            const struct vk_sync_wait *waits,
+                            enum vk_sync_wait_flags wait_flags,
+                            uint64_t abs_timeout_ns)
+{
+   if (wait_count == 0)
+      return VK_SUCCESS;
+
+   VkResult result = VK_SUCCESS;
+   for (uint32_t i = 0; i < wait_count; i++) {
+      const VkResult one = panvk_native_sync_wait(
+         device, waits[i].sync, waits[i].wait_value, wait_flags,
+         abs_timeout_ns);
+      if ((wait_flags & VK_SYNC_WAIT_ANY) && one == VK_SUCCESS)
+         return VK_SUCCESS;
+      if (one != VK_SUCCESS)
+         result = one;
+   }
+   return result;
+}
+
+static const struct vk_sync_type native_sync_type = {
+   .size = sizeof(struct panvk_native_sync),
+   .features = VK_SYNC_FEATURE_BINARY | VK_SYNC_FEATURE_GPU_WAIT |
+               VK_SYNC_FEATURE_CPU_WAIT | VK_SYNC_FEATURE_CPU_RESET |
+               VK_SYNC_FEATURE_WAIT_ANY,
+   .init = panvk_native_sync_init,
+   .finish = panvk_native_sync_finish,
+   .reset = panvk_native_sync_reset,
+   .wait = panvk_native_sync_wait,
+   .wait_many = panvk_native_sync_wait_many,
+};
+
+const struct vk_sync_type *
+panvk_native_sync_get_type(void)
+{
+   return &native_sync_type;
+}
+
+void
+panvk_native_sync_set_fence(struct vk_sync *sync, uint64_t fence)
+{
+   struct panvk_native_sync *native = to_native_sync(sync);
+   native->fence = fence;
+   native->signaled = fence == 0;
+}
+
+uint64_t
+panvk_native_sync_get_fence(const struct vk_sync *sync)
+{
+   const struct panvk_native_sync *native =
+      container_of(sync, struct panvk_native_sync, sync);
+   return native->fence;
+}
diff --git a/src/panfrost/vulkan/panvk_native_sync.h b/src/panfrost/vulkan/panvk_native_sync.h
new file mode 100644
index 0000000..8f5d598
--- /dev/null
+++ b/src/panfrost/vulkan/panvk_native_sync.h
@@ -0,0 +1,29 @@
+/*
+ * Copyright © 2026 MaliMetal contributors
+ * SPDX-License-Identifier: MIT
+ *
+ * A binary vk_sync whose payload is one opaque NativeMali fence. It is not a
+ * DRM syncobj and does not pretend to be one: no import/export, no timeline,
+ * and no invented userspace signal.
+ */
+#ifndef PANVK_NATIVE_SYNC_H
+#define PANVK_NATIVE_SYNC_H
+
+#include "vk_sync.h"
+
+const struct vk_sync_type *panvk_native_sync_get_type(void);
+
+/* Attach the fence produced by the last submit. The sync owns the opaque
+ * handle; a later vk_sync_reset() drops it. */
+void panvk_native_sync_set_fence(struct vk_sync *sync, uint64_t fence);
+
+/* Return the attached fence, or 0 when the sync has no payload. */
+uint64_t panvk_native_sync_get_fence(const struct vk_sync *sync);
+
+static inline bool
+panvk_sync_type_is_native_mali(const struct vk_sync_type *type)
+{
+   return type == panvk_native_sync_get_type();
+}
+
+#endif
