# MaliMetal patch 0002: a pan_kmod backend over the NativeMali C facade.
#
# Base: Mesa tag mesa-26.2.6, commit 8e87a503ebd91408c88596d1b9eeb5f4c0b2088d
# (deps/deps.toml). API v2 in deps/abi.sha256 supplies the feature words.
#
# Adds src/panfrost/lib/kmod/pan_kmod_native_mali.{c,h}: a skeleton backend.
# It refuses to create a device while the probe has not described it
# (mmu_features == 0), and returns failure for everything the ABI cannot
# honestly provide: mmap offsets, per-BO waits, VM unmap, import/export and
# perf counters. No register is touched from userspace.
#
# The module needs MaliMetal's native_mali_kmod.h on the include path; the CI
# job passes -Dc_args=-I<MaliMetal>/src/backend.
#
# Compiled by the mesa-patch CI job only. It is not run on hardware and does
# not make PanVK work on Mali.
diff --git a/src/panfrost/lib/kmod/meson.build b/src/panfrost/lib/kmod/meson.build
index cb021a3..7798b19 100644
--- a/src/panfrost/lib/kmod/meson.build
+++ b/src/panfrost/lib/kmod/meson.build
@@ -5,6 +5,7 @@ libpankmod_lib_files = files(
   'pan_kmod.c',
   'panfrost_kmod.c',
   'panthor_kmod.c',
+  'pan_kmod_native_mali.c',
 )

 libpankmod_lib = static_library(
diff --git a/src/panfrost/lib/kmod/pan_kmod_native_mali.c b/src/panfrost/lib/kmod/pan_kmod_native_mali.c
new file mode 100644
index 0000000..9c58bf8
--- /dev/null
+++ b/src/panfrost/lib/kmod/pan_kmod_native_mali.c
@@ -0,0 +1,368 @@
+/*
+ * Copyright © 2026 MaliMetal contributors
+ * SPDX-License-Identifier: MIT
+ *
+ * pan_kmod backend over the NativeMali C facade.
+ *
+ * This is a skeleton: it implements what the ABI can honestly provide today
+ * and returns failure for everything else. Unsupported is a result, not a
+ * fallback: no value is invented and no register is touched from userspace.
+ *
+ * Known ABI limits, all deliberate:
+ *   - there is no mmap offset, so bo_get_mmap_offset() fails;
+ *   - there is no per-BO wait, so bo_wait() returns false;
+ *   - there is no unmap-without-free, so VM UNMAP operations fail;
+ *   - VA is chosen by the facade allocator, so only AUTO_VA maps are accepted;
+ *   - import/export and perf are not in the ABI.
+ */
+#include "pan_kmod_backend.h"
+#include "pan_kmod_native_mali.h"
+
+#include "native_mali_kmod.h"
+
+#include "util/log.h"
+#include "util/macros.h"
+
+struct native_mali_dev {
+   struct pan_kmod_dev base;
+   struct NativeMaliKmod *kmod;
+   uint32_t next_handle;
+};
+
+struct native_mali_bo {
+   struct pan_kmod_bo base;
+   /* The ABI handle is 64-bit; pan_kmod_bo.handle is 32-bit and is used as a
+    * sparse-array index. Keep the real handle here rather than truncating. */
+   uint64_t handle;
+};
+
+static struct native_mali_dev *
+to_native_dev(struct pan_kmod_dev *dev)
+{
+   return container_of(dev, struct native_mali_dev, base);
+}
+
+static struct native_mali_bo *
+to_native_bo(struct pan_kmod_bo *bo)
+{
+   return container_of(bo, struct native_mali_bo, base);
+}
+
+static struct pan_kmod_va_range
+native_mali_query_va_range(const struct pan_kmod_dev *dev)
+{
+   const struct NativeMaliDeviceProps *props =
+      native_mali_kmod_props(to_native_dev((struct pan_kmod_dev *)dev)->kmod);
+
+   if (!props)
+      return (struct pan_kmod_va_range){0};
+
+   return (struct pan_kmod_va_range){.start = props->va_start,
+                                     .size = props->va_size};
+}
+
+static struct pan_kmod_bo *
+native_mali_bo_alloc(struct pan_kmod_dev *dev, struct pan_kmod_vm *exclusive_vm,
+                     uint64_t size, uint32_t flags)
+{
+   const uint32_t unsupported = PAN_KMOD_BO_FLAG_ALLOC_ON_FAULT |
+                                PAN_KMOD_BO_FLAG_WB_MMAP |
+                                PAN_KMOD_BO_FLAG_IMPORTED |
+                                PAN_KMOD_BO_FLAG_EXPORTED;
+
+   if (flags & unsupported) {
+      mesa_loge("native_mali: unsupported BO flags %#x", flags & unsupported);
+      return NULL;
+   }
+
+   struct native_mali_dev *ndev = to_native_dev(dev);
+   uint64_t handle = 0;
+   if (native_mali_kmod_alloc(ndev->kmod, size, &handle) != NATIVE_MALI_RESULT_OK)
+      return NULL;
+
+   struct native_mali_bo *bo = pan_kmod_dev_alloc(dev, sizeof(*bo));
+   if (!bo) {
+      (void)native_mali_kmod_free(ndev->kmod, handle, 0);
+      return NULL;
+   }
+
+   pan_kmod_bo_init(&bo->base, dev, exclusive_vm, size, flags, ndev->next_handle++);
+   bo->handle = handle;
+   return &bo->base;
+}
+
+static void
+native_mali_bo_free(struct pan_kmod_bo *bo)
+{
+   struct native_mali_bo *nbo = to_native_bo(bo);
+   struct NativeMaliKmod *kmod = to_native_dev(bo->dev)->kmod;
+
+   /* The facade has no "unmap now" call; freeing the BO drops its mapping.
+    * A guard fence of 0 is safe here only because panfrost releases a BO after
+    * the jobs referencing it completed (refcount). */
+   (void)native_mali_kmod_free(kmod, nbo->handle, 0);
+   pan_kmod_bo_cleanup(bo);
+   pan_kmod_dev_free(bo->dev, nbo);
+}
+
+static bool
+native_mali_bo_wait(struct pan_kmod_bo *bo, int64_t timeout_ns,
+                    bool for_read_only_access)
+{
+   (void)bo;
+   (void)timeout_ns;
+   (void)for_read_only_access;
+   /* The ABI has no per-BO wait; returning true would be a claim we cannot
+    * support. */
+   return false;
+}
+
+static off_t
+native_mali_bo_get_mmap_offset(struct pan_kmod_bo *bo)
+{
+   (void)bo;
+   return (off_t)-1;
+}
+
+static struct pan_kmod_vm *
+native_mali_vm_create(struct pan_kmod_dev *dev, uint32_t flags,
+                      uint64_t va_start, uint64_t va_range)
+{
+   (void)va_start;
+   (void)va_range;
+
+   if (!(flags & PAN_KMOD_VM_FLAG_AUTO_VA)) {
+      mesa_loge("native_mali: only AUTO_VA VMs are supported");
+      return NULL;
+   }
+
+   struct pan_kmod_vm *vm = pan_kmod_dev_alloc(dev, sizeof(*vm));
+   if (!vm)
+      return NULL;
+
+   pan_kmod_vm_init(vm, dev, 0, flags);
+   return vm;
+}
+
+static void
+native_mali_vm_destroy(struct pan_kmod_vm *vm)
+{
+   pan_kmod_vm_cleanup(vm);
+   pan_kmod_dev_free(vm->dev, vm);
+}
+
+static int
+native_mali_vm_bind(struct pan_kmod_vm *vm, enum pan_kmod_vm_op_mode mode,
+                    struct pan_kmod_vm_op *ops, uint32_t count)
+{
+   if (mode != PAN_KMOD_VM_OP_MODE_IMMEDIATE)
+      return -1;
+
+   for (uint32_t i = 0; i < count; i++) {
+      struct pan_kmod_vm_op *op = &ops[i];
+
+      if (op->wait.count || op->signal.count)
+         return -1;
+
+      if (op->type != PAN_KMOD_VM_OP_TYPE_MAP)
+         return -1; /* unmap/sync-only are not in the ABI */
+
+      if (op->va.start != PAN_KMOD_VM_MAP_AUTO_VA || op->map.bo_offset != 0)
+         return -1;
+
+      struct native_mali_bo *bo = to_native_bo(op->map.bo);
+      uint64_t iova = 0;
+      const uint32_t perms = NATIVE_MALI_PERMISSION_READ |
+                             NATIVE_MALI_PERMISSION_WRITE;
+      if (native_mali_kmod_map(to_native_dev(vm->dev)->kmod, bo->handle, perms,
+                               &iova) != NATIVE_MALI_RESULT_OK)
+         return -1;
+
+      op->va.start = iova;
+      op->va.size = bo->base.size;
+   }
+
+   return 0;
+}
+
+static int
+native_mali_flush_bo_map_syncs(struct pan_kmod_dev *dev)
+{
+   (void)dev;
+   return 0;
+}
+
+static void
+native_mali_bo_make_evictable(struct pan_kmod_bo *bo) { (void)bo; }
+
+static bool
+native_mali_bo_make_unevictable(struct pan_kmod_bo *bo)
+{
+   (void)bo;
+   return false;
+}
+
+static struct pan_kmod_bo *
+native_mali_bo_import(struct pan_kmod_dev *dev, uint32_t handle, uint64_t size)
+{
+   (void)dev; (void)handle; (void)size;
+   return NULL;
+}
+
+static int
+native_mali_bo_export(struct pan_kmod_bo *bo, int dmabuf_fd)
+{
+   (void)bo; (void)dmabuf_fd;
+   return -1;
+}
+
+static enum pan_kmod_vm_state
+native_mali_vm_query_state(struct pan_kmod_vm *vm)
+{
+   /* The ABI's GetStatus is device-wide: a fault or reset invalidates every
+    * VM, so map it onto the VM state honestly instead of always "usable". */
+   const NativeMaliResult status =
+      native_mali_kmod_refresh_status(to_native_dev(vm->dev)->kmod);
+   return status == NATIVE_MALI_RESULT_DEVICE_LOST ? PAN_KMOD_VM_FAULTY :
+                                                     PAN_KMOD_VM_USABLE;
+}
+
+static uint64_t
+native_mali_query_timestamp(const struct pan_kmod_dev *dev)
+{
+   (void)dev;
+   return 0;
+}
+
+static void
+native_mali_bo_set_label(struct pan_kmod_dev *dev, struct pan_kmod_bo *bo,
+                         const char *label)
+{
+   (void)dev; (void)bo; (void)label;
+}
+
+static struct pan_kmod_perf_session *
+native_mali_perf_create(struct pan_kmod_dev *dev)
+{
+   (void)dev;
+   return NULL; /* perf counters are not in the ABI */
+}
+
+static int
+native_mali_perf_enable(struct pan_kmod_perf_session *session,
+                        const struct pan_kmod_perf_config *cfg)
+{
+   (void)session; (void)cfg;
+   return -1;
+}
+
+static int
+native_mali_perf_disable(struct pan_kmod_perf_session *session)
+{
+   (void)session;
+   return -1;
+}
+
+static void
+native_mali_perf_dump(struct pan_kmod_perf_session *session,
+                      struct mali_perf_dump_info *info)
+{
+   (void)session; (void)info;
+}
+
+static void
+native_mali_perf_destroy(struct pan_kmod_perf_session *session)
+{
+   (void)session;
+}
+
+static void
+native_mali_dev_destroy(struct pan_kmod_dev *dev)
+{
+   struct native_mali_dev *ndev = to_native_dev(dev);
+
+   pan_kmod_dev_cleanup(dev);
+   pan_kmod_free(dev->allocator, ndev);
+}
+
+static const struct pan_kmod_ops native_mali_ops = {
+   .dev_create = NULL, /* creation goes through pan_kmod_dev_create_native_mali */
+   .dev_destroy = native_mali_dev_destroy,
+   .dev_query_user_va_range = native_mali_query_va_range,
+   .bo_alloc = native_mali_bo_alloc,
+   .bo_free = native_mali_bo_free,
+   .bo_import = native_mali_bo_import,
+   .bo_export = native_mali_bo_export,
+   .bo_get_mmap_offset = native_mali_bo_get_mmap_offset,
+   .flush_bo_map_syncs = native_mali_flush_bo_map_syncs,
+   .bo_wait = native_mali_bo_wait,
+   .bo_make_evictable = native_mali_bo_make_evictable,
+   .bo_make_unevictable = native_mali_bo_make_unevictable,
+   .vm_create = native_mali_vm_create,
+   .vm_destroy = native_mali_vm_destroy,
+   .vm_bind = native_mali_vm_bind,
+   .vm_query_state = native_mali_vm_query_state,
+   .query_timestamp = native_mali_query_timestamp,
+   .bo_set_label = native_mali_bo_set_label,
+   .perf_create = native_mali_perf_create,
+   .perf_destroy = native_mali_perf_destroy,
+   .perf_enable = native_mali_perf_enable,
+   .perf_disable = native_mali_perf_disable,
+   .perf_dump = native_mali_perf_dump,
+};
+
+struct pan_kmod_dev *
+pan_kmod_dev_create_native_mali(struct NativeMaliKmod *kmod,
+                                const struct pan_kmod_allocator *allocator)
+{
+   if (!kmod || !allocator)
+      return NULL;
+
+   const struct NativeMaliDeviceProps *src = native_mali_kmod_props(kmod);
+   if (!src)
+      return NULL;
+
+   /* A zero feature word means "the probe did not answer". Refuse instead of
+    * constructing a plausible-looking device. */
+   if (src->mmu_features == 0 || src->pgsize_shift != 12 ||
+       src->shader_present_lo == 0) {
+      mesa_loge("native_mali: probe has not described the device "
+                "(mmu=%#x pgsize=%u shader=%#x)",
+                src->mmu_features, src->pgsize_shift, src->shader_present_lo);
+      return NULL;
+   }
+
+   struct native_mali_dev *ndev = pan_kmod_alloc(allocator, sizeof(*ndev));
+   if (!ndev)
+      return NULL;
+
+   const struct pan_kmod_driver driver = {.version = {.major = 0, .minor = 0}};
+   pan_kmod_dev_init(&ndev->base, -1, 0, &driver, &native_mali_ops, allocator);
+   ndev->kmod = kmod;
+   ndev->next_handle = 1;
+
+   struct pan_kmod_dev_props *p = &ndev->base.props;
+   p->gpu_id = src->gpu_id;
+   p->gpu_variant = 0; /* no register source; panfrost leaves it zero too */
+   p->shader_present = src->shader_present_lo |
+      ((uint64_t)src->shader_present_hi << 32);
+   p->tiler_features = src->tiler_features;
+   p->mem_features = src->mem_features;
+   p->mmu_features = src->mmu_features;
+   p->l2_features = src->l2_features;
+   for (unsigned i = 0; i < ARRAY_SIZE(p->texture_features); i++)
+      p->texture_features[i] = src->texture_features[i];
+   p->max_threads_per_core = src->thread_max_threads;
+   p->max_threads_per_wg = src->max_workgroup_size;
+   p->max_tasks_per_core = src->max_tasks_per_core;
+   p->num_registers_per_core = src->registers_per_core;
+   p->max_tls_instance_per_core = src->tls_instances_per_core;
+   p->afbc_features = src->afbc_features;
+   p->pgsize_bitmap = PAN_PGSIZE_4K;
+   p->supported_bo_flags = PAN_KMOD_BO_FLAG_EXECUTABLE |
+                           PAN_KMOD_BO_FLAG_NO_MMAP;
+   p->supported_vm_op_flags = 0;
+   p->is_io_coherent = false;
+
+   return &ndev->base;
+}
diff --git a/src/panfrost/lib/kmod/pan_kmod_native_mali.h b/src/panfrost/lib/kmod/pan_kmod_native_mali.h
new file mode 100644
index 0000000..096d519
--- /dev/null
+++ b/src/panfrost/lib/kmod/pan_kmod_native_mali.h
@@ -0,0 +1,20 @@
+/*
+ * Copyright © 2026 MaliMetal contributors
+ * SPDX-License-Identifier: MIT
+ *
+ * A pan_kmod device backed by the NativeMali C facade instead of a DRM node.
+ * The facade (native_mali_kmod.h) is provided by the MaliMetal tree; this
+ * header deliberately keeps Mesa's public pan_kmod.h free of that type.
+ */
+#pragma once
+
+#include "pan_kmod.h"
+
+struct NativeMaliKmod;
+
+/* Returns NULL when the facade has not been probed far enough to describe the
+ * device (mmu_features == 0) or when the page shift is not 12. No property is
+ * guessed. The caller keeps ownership of `kmod`. */
+struct pan_kmod_dev *
+pan_kmod_dev_create_native_mali(struct NativeMaliKmod *kmod,
+                                const struct pan_kmod_allocator *allocator);
