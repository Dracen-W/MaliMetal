# MaliMetal patch 0003: generic submit and fence-wait operations.
#
# Base: Mesa tag mesa-26.2.6, commit 8e87a503ebd91408c88596d1b9eeb5f4c0b2088d.
# Depends on 0002 (the NativeMali backend) for its implementation.
#
# Adds pan_kmod_submit and the submit/wait_fence ops. The DRM backends leave
# them NULL because their submission is the JM ioctl path; the NativeMali
# backend implements them over the facade. Callers must treat NULL as
# "unsupported", never as "nothing to do".
#
# Compiled by the mesa-patch CI job. Nothing here is run on hardware.
diff --git a/src/panfrost/lib/kmod/pan_kmod.h b/src/panfrost/lib/kmod/pan_kmod.h
index 23916f6..fa73456 100644
--- a/src/panfrost/lib/kmod/pan_kmod.h
+++ b/src/panfrost/lib/kmod/pan_kmod.h
@@ -337,6 +337,17 @@ enum pan_kmod_vm_op_type {
 };

 /* VM operation data. */
+struct pan_kmod_submit {
+   /* GPU address of the job chain, 64-byte aligned and inside a mapping. */
+   uint64_t job_chain;
+
+   /* 0, or an earlier fence of this client. */
+   uint64_t wait_fence;
+
+   /* Used only when wait_fence is nonzero. 0 polls once. */
+   uint64_t wait_timeout_ns;
+};
+
 struct pan_kmod_vm_op {
    /* The type of operation being requested. */
    enum pan_kmod_vm_op_type type;
@@ -529,6 +540,20 @@ struct pan_kmod_ops {
     */
    enum pan_kmod_vm_state (*vm_query_state)(struct pan_kmod_vm *vm);

+   /* Submit a job chain. `job_chain` is a GPU address in memory this device
+    * mapped, 64-byte aligned. `wait_fence` is 0 or an earlier fence of this
+    * client. On success *out_fence is a nonzero opaque fence.
+    *
+    * Optional: backends without a submission path leave it NULL, and callers
+    * must refuse rather than fall back.
+    */
+   int (*submit)(struct pan_kmod_dev *dev,
+                 const struct pan_kmod_submit *submit, uint64_t *out_fence);
+
+   /* Wait for an opaque fence. Returns 0 on completion, -1 otherwise. */
+   int (*wait_fence)(struct pan_kmod_dev *dev, uint64_t fence,
+                     uint64_t timeout_ns);
+
    /* Query the current GPU timestamp */
    uint64_t (*query_timestamp)(const struct pan_kmod_dev *dev);

diff --git a/src/panfrost/lib/kmod/pan_kmod_native_mali.c b/src/panfrost/lib/kmod/pan_kmod_native_mali.c
index 9c58bf8..2cb6901 100644
--- a/src/panfrost/lib/kmod/pan_kmod_native_mali.c
+++ b/src/panfrost/lib/kmod/pan_kmod_native_mali.c
@@ -227,6 +227,32 @@ native_mali_vm_query_state(struct pan_kmod_vm *vm)
                                                      PAN_KMOD_VM_USABLE;
 }

+static int
+native_mali_submit(struct pan_kmod_dev *dev, const struct pan_kmod_submit *submit,
+                   uint64_t *out_fence)
+{
+   if (!submit || !out_fence || submit->job_chain == 0)
+      return -1;
+
+   const NativeMaliResult result =
+      native_mali_kmod_submit(to_native_dev(dev)->kmod, submit->job_chain,
+                              submit->wait_fence, submit->wait_timeout_ns,
+                              out_fence);
+   return result == NATIVE_MALI_RESULT_OK ? 0 : -1;
+}
+
+static int
+native_mali_wait_fence(struct pan_kmod_dev *dev, uint64_t fence,
+                       uint64_t timeout_ns)
+{
+   if (fence == 0)
+      return -1;
+
+   const NativeMaliResult result =
+      native_mali_kmod_wait(to_native_dev(dev)->kmod, fence, timeout_ns);
+   return result == NATIVE_MALI_RESULT_OK ? 0 : -1;
+}
+
 static uint64_t
 native_mali_query_timestamp(const struct pan_kmod_dev *dev)
 {
@@ -302,6 +328,8 @@ static const struct pan_kmod_ops native_mali_ops = {
    .vm_destroy = native_mali_vm_destroy,
    .vm_bind = native_mali_vm_bind,
    .vm_query_state = native_mali_vm_query_state,
+   .submit = native_mali_submit,
+   .wait_fence = native_mali_wait_fence,
    .query_timestamp = native_mali_query_timestamp,
    .bo_set_label = native_mali_bo_set_label,
    .perf_create = native_mali_perf_create,
